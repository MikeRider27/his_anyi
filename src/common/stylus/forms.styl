.el-form-item__label
  color: #34495e
  font-weight: 600

.el-input__inner,
.el-textarea__inner
  border: 1px solid #d7e0e8
  border-radius: 8px
  box-shadow: none
  color: #2c3e50
  transition: border-color 0.2s ease, box-shadow 0.2s ease

.el-input__inner:hover,
.el-textarea__inner:hover
  border-color: #aebdc9

.el-input__inner:focus,
.el-textarea__inner:focus
  border-color: #167d77
  box-shadow: 0 0 0 3px rgba(22, 125, 119, 0.12)
  outline: none

.el-form .el-button
  border-radius: 8px
  font-weight: 500
  transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease

.el-form .el-button--primary
  background-color: #167d77
  border-color: #167d77

.el-form .el-button--primary:hover,
.el-form .el-button--primary:focus
  background-color: #116b66
  border-color: #116b66

.el-form .el-button--primary:focus
  box-shadow: 0 0 0 3px rgba(22, 125, 119, 0.16)

.el-dialog.app-dialog
  max-width: calc(100vw - 32px)
  border-radius: 12px
  overflow: hidden

.el-dialog.app-dialog .el-dialog__header
  padding: 20px 24px 16px
  border-bottom: 1px solid #e8eef2

.el-dialog.app-dialog .el-dialog__title
  color: #263b4d
  font-size: 18px
  font-weight: 600

.el-dialog.app-dialog .el-dialog__body
  max-height: calc(100vh - 190px)
  overflow-y: auto
  padding: 20px 24px

.el-dialog.app-dialog .el-form
  box-sizing: border-box
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  column-gap: 24px
  width: 100% !important
  margin: 0 !important
  padding: 0 !important

.el-dialog.app-dialog .el-form-item
  min-width: 0
  margin-bottom: 16px

.el-dialog.app-dialog .el-form-item__label
  display: block
  float: none
  width: 100% !important
  padding: 0 0 6px
  line-height: 1.4
  text-align: left
  white-space: normal

.el-dialog.app-dialog .el-form-item__content
  min-width: 0
  margin-left: 0 !important

.el-dialog.app-dialog .el-input,
.el-dialog.app-dialog .el-select,
.el-dialog.app-dialog .el-date-editor
  max-width: 100%

.el-dialog.app-dialog .el-dialog__footer
  padding: 14px 24px 20px
  border-top: 1px solid #e8eef2

@media (max-width: 700px)
  .el-dialog.app-dialog
    width: calc(100vw - 32px) !important
    margin: 12px auto !important

  .el-dialog.app-dialog .el-dialog__body
    max-height: calc(100vh - 160px)
    padding: 16px

  .el-dialog.app-dialog .el-dialog__header
    padding: 16px 16px 12px

  .el-dialog.app-dialog .el-dialog__footer
    padding: 12px 16px 16px

  .el-dialog.app-dialog .el-form
    grid-template-columns: minmax(0, 1fr)
